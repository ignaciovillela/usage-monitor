{
  "name": "usage-monitor",
  "version": "0.2.0",
  "description": "Tray/Dock icon that shows your Claude usage and projects it until the window resets (macOS and Windows).",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "selftest": "electron . --selftest",
    "test": "node --test tests/",
    "backtest": "node tests/run-backtest.js",
    "build": "bash scripts/build-app.sh",
    "build:win": "node scripts/build-win.js",
    "build:mac": "bash scripts/build-app.sh",
    "dmg": "bash scripts/make-dmg.sh \"dist/Usage Monitor-darwin-$(uname -m)/Usage Monitor.app\" \"dist/Usage-Monitor-macos-$(uname -m).dmg\""
  },
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^45.1.0"
  }
}
