# Cookie «sessionKey» de claude.ai (navegador → herramientas de desarrollo → Application/Storage → Cookies → claude.ai).
# Da acceso a tu cuenta: guárdala solo en el servidor. Caduca cada cierto tiempo; al renovarla, reinicia el contenedor.
CLAUDE_SESSION_KEY=sk-ant-sid01-...

# Token que la app enviará como «Authorization: Bearer …». Genera uno con: openssl rand -hex 24
API_TOKEN=

# Opcionales
# CLAUDE_ORG_ID=          # si tienes varias organizaciones y quieres una concreta
# POLL_SECONDS=60         # mínimo 30
# PORT=8787
# REFRESH_MIN_SECONDS=15  # mínimo entre actualizaciones pedidas con POST /usage
